# ========================================================
# FILE MẪU BIẾN MÔI TRƯỜNG DỰ ÁN (ENV EXAMPLE)
# Hướng dẫn: Sao chép nội dung file này thành `.env` và điền
# thông tin tài khoản DB trên máy cá nhân của bạn.
# ========================================================

# 1. CẤU HÌNH MÁY CHỦ (SERVER CONFIG)
PORT=5000
NODE_ENV=development

# 2. CƠ SỞ DỮ LIỆU POSTGRESQL (DATABASE CONFIG)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/quanlyphongkham?schema=public"
DIRECT_URL="postgresql://postgres.zdkkwlbohxuqxjvtjkga:[password].@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 3. BẢO MẬT & XÁC THỰC TÀI KHOẢN (JWT SECURITY)
JWT_SECRET=your_super_secret_jwt_access_token_key_here
JWT_EXPIRES_IN=1d

JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here
JWT_REFRESH_EXPIRES_IN=30d

# 4. CẤU HÌNH ĐẶT LỊCH & PHIÊN ĐĂNG NHẬP
SLOT_MINUTES=30
MAX_ADVANCE_DAYS=30
MIN_LEAD_MINUTES=0
REFRESH_TOKEN_DAYS=30
OTP_TTL_MINUTES=10
AUTH_CACHE_TTL_MS=15000

# 5. TÀI KHOẢN ADMIN KHỞI TẠO (dùng cho prisma/seed.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_PHONE=0900000000

# 6. BẢO MẬT TÊN MIỀN TRUY CẬP (CORS ORIGIN)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
