generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bacsi {
  mabs               Int          @id
  mack               Int
  sogiayphephanhnghe String       @unique @db.VarChar(50)
  hocham             String?      @db.VarChar(50)
  kinhnghiem         Int          @default(0)
  chuyenkhoa         chuyenkhoa   @relation(fields: [mack], references: [mack], map: "fk_bacsi_chuyenkhoa")
  nhanvien           nhanvien     @relation(fields: [mabs], references: [manv], onDelete: Cascade, map: "fk_bacsi_nhanvien")
  lichhen            lichhen[]
  lichsukham         lichsukham[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model benhnhan {
  mabn       Int            @id @default(autoincrement())
  matk       Int?           @unique
  hoten      String         @db.VarChar(100)
  gioitinh   gioi_tinh_enum
  ngaysinh   DateTime       @db.Date
  sdt        String         @db.VarChar(15)
  diachi     String?        @db.VarChar(255)
  cccd       String?        @unique @db.VarChar(12)
  sobhyt     String?        @unique @db.VarChar(20)
  ngaydangky DateTime       @default(dbgenerated("CURRENT_DATE")) @db.Date
  taikhoan   taikhoan?      @relation(fields: [matk], references: [matk], map: "fk_benhnhan_taikhoan")
  hoadon     hoadon[]
  hosobenhan hosobenhan?
  lichhen    lichhen[]
  lichsukham lichsukham[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model calamviec {
  maca            Int               @id @default(autoincrement())
  ngay            DateTime          @db.Date
  giobatdau       DateTime          @db.Time(6)
  gioketthuc      DateTime          @db.Time(6)
  maphong         Int
  phongkham       phongkham         @relation(fields: [maphong], references: [maphong], map: "fk_calamviec_phongkham")
  phanconglamviec phanconglamviec[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model chitietdichvukham {
  mactdvk    Int        @id @default(autoincrement())
  malsk      Int
  madv       Int
  ketqua     String?
  soluong    Int        @default(1)
  dichvu     dichvu     @relation(fields: [madv], references: [madv], map: "fk_ctdvk_dichvu")
  lichsukham lichsukham @relation(fields: [malsk], references: [malsk], onDelete: Cascade, map: "fk_ctdvk_lichsukham")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model chitietdonthuoc {
  mactdt         Int      @id @default(autoincrement())
  madt           Int
  mathuoc        Int
  soluong        Int
  lieudung       String?  @db.VarChar(100)
  thoigiansudung String?  @db.VarChar(100)
  donthuoc       donthuoc @relation(fields: [madt], references: [madt], onDelete: Cascade, map: "fk_ctdt_donthuoc")
  thuoc          thuoc    @relation(fields: [mathuoc], references: [mathuoc], map: "fk_ctdt_thuoc")

  @@unique([madt, mathuoc], map: "uq_ctdt_dt_thuoc")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model chitiethoadon {
  macthd    Int       @id @default(autoincrement())
  mahd      Int
  mathuoc   Int?
  madv      Int?
  madt      Int?
  soluong   Int
  dongia    Decimal   @db.Decimal(12, 2)
  // Lưu ý: trong PostgreSQL đây là cột GENERATED ALWAYS AS ((soluong)::numeric * dongia) STORED.
  // Prisma không hỗ trợ generated column nên vẫn khai báo dbgenerated; khi sinh migration phải giữ GENERATED.
  thanhtien Decimal?  @default(dbgenerated("((soluong)::numeric * dongia)")) @db.Decimal(14, 2)
  dichvu    dichvu?   @relation(fields: [madv], references: [madv], onDelete: Restrict, map: "fk_cthd_dichvu")
  donthuoc  donthuoc? @relation(fields: [madt], references: [madt], map: "fk_cthd_donthuoc")
  hoadon    hoadon    @relation(fields: [mahd], references: [mahd], onDelete: Cascade, map: "fk_cthd_hoadon")
  thuoc     thuoc?    @relation(fields: [mathuoc], references: [mathuoc], onDelete: Restrict, map: "fk_cthd_thuoc")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model chuyenkhoa {
  mack          Int         @id @default(autoincrement())
  tenchuyenkhoa String      @unique @db.VarChar(100)
  mota          String?
  bacsi         bacsi[]
  dichvu        dichvu[]
  phongkham     phongkham[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dichvu {
  madv              Int                 @id @default(autoincrement())
  tendichvu         String              @db.VarChar(100)
  dongia            Decimal             @db.Decimal(12, 2)
  mack              Int?
  chitietdichvukham chitietdichvukham[]
  chitiethoadon     chitiethoadon[]
  chuyenkhoa        chuyenkhoa?         @relation(fields: [mack], references: [mack], map: "fk_dichvu_chuyenkhoa")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model donthuoc {
  madt            Int               @id @default(autoincrement())
  malsk           Int               @unique
  ngayke          DateTime          @default(dbgenerated("CURRENT_DATE")) @db.Date
  ghichubacsi     String?
  chitietdonthuoc chitietdonthuoc[]
  chitiethoadon   chitiethoadon[]
  lichsukham      lichsukham        @relation(fields: [malsk], references: [malsk], onDelete: Cascade, map: "fk_donthuoc_lichsukham")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model hoadon {
  mahd               Int                       @id @default(autoincrement())
  mabn               Int
  malsk              Int                       @unique
  ngaylap            DateTime                  @default(now()) @db.Timestamp(6)
  ngaythanhtoan      DateTime?                 @db.Timestamp(6)
  tongtien           Decimal                   @default(0) @db.Decimal(14, 2)
  trangthaithanhtoan trang_thai_thanhtoan_enum @default(ChuaThanhToan)
  phuongthuctt       phuong_thuc_tt_enum?
  chitiethoadon      chitiethoadon[]
  hoantien           hoantien[]
  benhnhan           benhnhan                  @relation(fields: [mabn], references: [mabn], map: "fk_hoadon_benhnhan")
  lichsukham         lichsukham                @relation(fields: [malsk], references: [malsk], map: "fk_hoadon_lichsukham")

  @@index([ngaythanhtoan])
  @@index([trangthaithanhtoan])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model hosobenhan {
  mahsba     Int            @id
  nhommau    nhom_mau_enum? @default(ChuaRo)
  tiensubenh String?
  diung      String?
  ghichu     String?
  benhnhan   benhnhan       @relation(fields: [mahsba], references: [mabn], onDelete: Cascade, map: "fk_hosobenhan_benhnhan")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lichhen {
  malh            Int                     @id @default(autoincrement())
  mabn            Int
  mabs            Int
  ngayhen         DateTime                @db.Date
  giohen          DateTime                @db.Time(6)
  trangthai       trang_thai_lichhen_enum @default(ChoXacNhan)
  lydokham        String?                 @db.VarChar(255)
  lydohuy         String?                 @db.VarChar(255)
  thoigianhuy     DateTime?               @db.Timestamp(6)
  thoigiantiepdon DateTime?               @db.Timestamp(6)
  sohangcho       Int?
  bacsi           bacsi                   @relation(fields: [mabs], references: [mabs], map: "fk_lichhen_bacsi")
  benhnhan        benhnhan                @relation(fields: [mabn], references: [mabn], onDelete: Cascade, map: "fk_lichhen_benhnhan")
  lichsukham      lichsukham?

  @@index([ngayhen])
  @@index([mabs, ngayhen])
  @@index([mabn, ngayhen])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lichsukham {
  malsk             Int                 @id @default(autoincrement())
  mabn              Int
  mabs              Int
  malh              Int?                @unique
  ngay              DateTime            @default(now()) @db.Timestamp(6)
  trieuchung        String?
  chandoan          String?
  ketluan           String?
  chitietdichvukham chitietdichvukham[]
  donthuoc          donthuoc?
  hoadon            hoadon?
  bacsi             bacsi               @relation(fields: [mabs], references: [mabs], map: "fk_lichsukham_bacsi")
  benhnhan          benhnhan            @relation(fields: [mabn], references: [mabn], map: "fk_lichsukham_benhnhan")
  lichhen           lichhen?            @relation(fields: [malh], references: [malh], map: "fk_lichsukham_lichhen")

  @@index([ngay])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model nhanvien {
  manv            Int               @id @default(autoincrement())
  matk            Int?              @unique
  hoten           String            @db.VarChar(100)
  gioitinh        gioi_tinh_enum
  ngaysinh        DateTime          @db.Date
  sdt             String            @unique @db.VarChar(15)
  diachi          String?           @db.VarChar(255)
  chucvu          chuc_vu_enum
  ngayvaolam      DateTime          @db.Date
  bacsi           bacsi?
  taikhoan        taikhoan?         @relation(fields: [matk], references: [matk], map: "fk_nhanvien_taikhoan")
  phanconglamviec phanconglamviec[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model phanconglamviec {
  mapclv        Int       @id @default(autoincrement())
  manv          Int
  maca          Int
  vaitrotrongca String?   @db.VarChar(50)
  calamviec     calamviec @relation(fields: [maca], references: [maca], onDelete: Cascade, map: "fk_pclv_calamviec")
  nhanvien      nhanvien  @relation(fields: [manv], references: [manv], onDelete: Cascade, map: "fk_pclv_nhanvien")

  @@unique([manv, maca], map: "uq_pclv_nv_ca")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model phongkham {
  maphong    Int                       @id @default(autoincrement())
  tenphong   String                    @unique @db.VarChar(50)
  mack       Int
  trangthai  trang_thai_phongkham_enum @default(SanSang)
  calamviec  calamviec[]
  chuyenkhoa chuyenkhoa                @relation(fields: [mack], references: [mack], map: "fk_phongkham_chuyenkhoa")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model taikhoan {
  matk           Int                      @id @default(autoincrement())
  tendangnhap    String                   @unique @db.VarChar(50)
  matkhau        String                   @db.VarChar(255)
  vaitro         vai_tro_enum
  trangthai      trang_thai_taikhoan_enum @default(HoatDong)
  ngaytao        DateTime                 @default(now()) @db.Timestamp(6)
  benhnhan       benhnhan?
  nhanvien       nhanvien?
  refresh_token  refresh_token[]
  password_reset password_reset[]
  hoantien       hoantien[]
  nhatky         nhatky[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model thuoc {
  mathuoc         Int               @id @default(autoincrement())
  tenthuoc        String            @db.VarChar(150)
  donvitinh       String            @db.VarChar(20)
  dongia          Decimal           @db.Decimal(12, 2)
  soluongton      Int               @default(0)
  hansudung       DateTime          @db.Date
  nhasanxuat      String?           @db.VarChar(100)
  chitietdonthuoc chitietdonthuoc[]
  chitiethoadon   chitiethoadon[]
}

// ========================================================
// CÁC BẢNG BỔ SUNG: HOÀN TIỀN, REFRESH TOKEN, QUÊN MẬT KHẨU, NHẬT KÝ
// ========================================================

model hoantien {
  maht       Int                  @id @default(autoincrement())
  mahd       Int
  matk       Int?
  sotien     Decimal              @db.Decimal(14, 2)
  lydo       String               @db.VarChar(255)
  phuongthuc phuong_thuc_tt_enum?
  ngaytao    DateTime             @default(now()) @db.Timestamp(6)
  hoadon     hoadon               @relation(fields: [mahd], references: [mahd], map: "fk_hoantien_hoadon")
  taikhoan   taikhoan?            @relation(fields: [matk], references: [matk], map: "fk_hoantien_taikhoan")

  @@index([mahd])
  @@index([ngaytao])
}

model refresh_token {
  mrt              Int       @id @default(autoincrement())
  matk             Int
  token_hash       String    @unique @db.VarChar(64)
  expires_at       DateTime  @db.Timestamp(6)
  revoked_at       DateTime? @db.Timestamp(6)
  replaced_by_hash String?   @db.VarChar(64)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  taikhoan         taikhoan  @relation(fields: [matk], references: [matk], onDelete: Cascade, map: "fk_refresh_token_taikhoan")

  @@index([matk])
  @@index([expires_at])
}

model password_reset {
  mpr        Int       @id @default(autoincrement())
  matk       Int
  otp_hash   String    @db.VarChar(64)
  expires_at DateTime  @db.Timestamp(6)
  used_at    DateTime? @db.Timestamp(6)
  attempts   Int       @default(0)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  taikhoan   taikhoan  @relation(fields: [matk], references: [matk], onDelete: Cascade, map: "fk_password_reset_taikhoan")

  @@index([matk])
  @@index([expires_at])
}

model nhatky {
  mank        Int       @id @default(autoincrement())
  matk        Int?
  hanhdong    String    @db.VarChar(50)
  doituong    String    @db.VarChar(50)
  doituongId  Int?
  dulieutruoc Json?
  dulieusau   Json?
  ip          String?   @db.VarChar(45)
  thoidiem    DateTime  @default(now()) @db.Timestamp(6)
  taikhoan    taikhoan? @relation(fields: [matk], references: [matk], map: "fk_nhatky_taikhoan")

  @@index([thoidiem])
  @@index([doituong, doituongId])
}

enum chuc_vu_enum {
  BacSi
  YTa
  LeTan
  QuanLy
}

enum gioi_tinh_enum {
  Nam
  Nu
  Khac
}

enum nhom_mau_enum {
  A
  B
  AB
  O
  ChuaRo
}

enum phuong_thuc_tt_enum {
  TienMat
  ChuyenKhoan
  TheThanhToan
  ViDienTu
}

enum trang_thai_lichhen_enum {
  ChoXacNhan
  DaXacNhan
  DaTiepDon
  DaKham
  DaHuy
}

enum trang_thai_phongkham_enum {
  SanSang
  DangSuDung
  BaoTri
}

enum trang_thai_taikhoan_enum {
  HoatDong
  KhoaTaiKhoan
}

enum trang_thai_thanhtoan_enum {
  ChuaThanhToan
  DaThanhToan
  DaHuy
}

enum vai_tro_enum {
  Admin
  BacSi
  YTa
  LeTan
  BenhNhan
}
