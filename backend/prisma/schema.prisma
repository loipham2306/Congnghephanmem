  ghichubacsi     String?
  chitietdonthuoc chitietdonthuoc[]
  chitiethoadon   chitiethoadon[]
  lichsukham      lichsukham        @relation(fields: [malsk], references: [malsk], onDelete: Cascade, map: "fk_donthuoc_lichsukham")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model hoadon {
  mahd               Int                       @id @default(autoincrement())
  mabn               Int
  malsk              Int                       @unique
  ngaylap            DateTime                  @default(now()) @db.Timestamp(6)
  tongtien           Decimal                   @default(0) @db.Decimal(14, 2)
  trangthaithanhtoan trang_thai_thanhtoan_enum @default(ChuaThanhToan)
  phuongthuctt       phuong_thuc_tt_enum?
