  ngay            DateTime          @db.Date
  giobatdau       DateTime          @db.Time(6)
  gioketthuc      DateTime          @db.Time(6)
  maphong         Int
  phongkham       phongkham         @relation(fields: [maphong], references: [maphong], map: "fk_calamviec_phongkham")
  phanconglamviec phanconglamviec[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
