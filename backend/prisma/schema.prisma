  ketqua     String?
  soluong    Int        @default(1)
  dichvu     dichvu     @relation(fields: [madv], references: [madv], map: "fk_ctdvk_dichvu")
  lichsukham lichsukham @relation(fields: [malsk], references: [malsk], onDelete: Cascade, map: "fk_ctdvk_lichsukham")
