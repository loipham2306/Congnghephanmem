# ========================================================
# 1. CẤU HÌNH MÁY CHỦ (SERVER CONFIG)
# ================================================postg========
PORT=5000
NODE_ENV=development

# ========================================================
# 2. CƠ SỞ DỮ LIỆU POSTGRESQL (DATABASE CONFIG)
# Cú pháp: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE_NAME]?schema=public
# Hãy thay đổi user, password và tên database theo máy tính cục bộ của bạn
# ========================================================
DATABASE_URL="postgresql://postgres.zdkkwlbohxuqxjvtjkga:nguyenducBao05%40.@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.zdkkwlbohxuqxjvtjkga:nguyenducBao05%40.@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# ========================================================
# 3. BẢO MẬT & XÁC THỰC TÀI KHOẢN (JWT SECURITY)
# Khóa bí mật dùng để ký và xác thực token đăng nhập
# ========================================================
JWT_SECRET=phongkham_secret_key_2026_dev_access_token_secure
JWT_EXPIRES_IN=1d

JWT_REFRESH_SECRET=phongkham_secret_key_2026_dev_refresh_token_secure
JWT_REFRESH_EXPIRES_IN=30d

# ========================================================
# 4. BẢO MẬT TÊN MIỀN TRUY CẬP (CORS ORIGIN)
# Danh sách các domain Frontend (React/Vite) được phép gọi API
# Các domain phân cách nhau bằng dấu phẩy
# ========================================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173